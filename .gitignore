# ═══════════════════════════════════════════════
# FocusLearn — Root .gitignore
# ═══════════════════════════════════════════════

# ── Sensitive Environment Variables & Secrets ──
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example

# ── Dependencies ──
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Production & Build Artifacts ──
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
.next/

# ── Debug Logs & Runtime Data ──
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage ──
coverage/
**/coverage/
.nyc_output/

# ── OS & System Generated Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── Editor & IDE Directories ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Cache & Temporary Files ──
.eslintcache
.stylelintcache
*.tsbuildinfo
.temp/
tmp/
scratch/
